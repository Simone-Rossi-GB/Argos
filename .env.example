# ── Mapbox (dashboard) ─────────────────────────────────────────────────────
# Public Mapbox access token (pk.xxxxx). Baked into the frontend bundle at
# build time, so a rebuild of the `dashboard` image is required after changes.
MAPBOX_TOKEN=

# ── Frontend → Backend URLs ────────────────────────────────────────────────
# Public URLs the browser uses to reach the backend. Also baked into the
# dashboard bundle at build time.
NEXT_PUBLIC_API_URL=http://localhost:10170/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:10170/api/v1/ws

# ── MinIO / Object storage ─────────────────────────────────────────────────
# MINIO_ENABLED toggles MinIO-backed media storage; if false the backend
# falls back to local disk under ./uploads.
MINIO_ENABLED=true
# Endpoint the backend uses inside the Docker network.
MINIO_ENDPOINT=minio:9000
# Endpoint the browser uses; presigned URLs are re-signed against this host
# so the dashboard can fetch clips directly.
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=uploads
MINIO_SECURE=false
